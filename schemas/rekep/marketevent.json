        },
        "required": false,
        "doc": "The identities of the events this one descends from, sorted and unique."
      },
      {
        "id": 17,
        "name": "srcuuids",
        "type": {
          "type": "list",
          "element-id": 52,
          "element": "fixed[16]",
          "element-required": true
        },
        "required": false,
        "doc": "The sorted unique identities of the elements this event was read from: provenance, never lineage - no walk moves it."
      },
      {
        "id": 18,
