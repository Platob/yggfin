      {
        "id": 1,
        "name": "currunix",
        "type": "timestamptz",
        "required": true,
        "doc": "When the event happened: the settled instant, UTC."
      },
      {
        "id": 2,
        "name": "creaunix",
        "type": "timestamptz",
        "required": false,
        "doc": "When the event was created, where that is known; the earliest its chain knows once followed."
      },
      {
        "id": 3,
        "name": "execunix",
        "type": "timestamptz",
        "required": false,
        "doc": "The latest execution clock this lifecycle reached as of this event; an execution dates itself, following carries it, and duplicate statements keep their earliest observation."
      },
      {
        "id": 4,
        "name": "recdunix",
        "type": "timestamptz",
        "required": false,
        "doc": "When this event was recorded, where that is known; the earliest its statements know."
      },
      {
        "id": 5,
        "name": "refrecdunix",
        "type": "timestamptz",
        "required": false,
        "doc": "The recording clock of the observation selected as this event's merge reference; the latest its statements know."
      },
      {
        "id": 6,
        "name": "exprtime",
        "type": "timestamptz",
        "required": false,
        "doc": "When the event stops being good, where it does; the latest its chain knows once followed."
      },
      {
        "id": 7,
        "name": "prevunix",
        "type": "timestamptz",
        "required": false,
        "doc": "When the event this one follows happened, where it follows one."
      },
      {
        "id": 8,
        "name": "snapunix",
        "type": "timestamptz",
        "required": false,
        "doc": "The grid instant a walk read this event as the snapshot of; empty on every row no snapshot was taken of."
      },
      {
        "id": 9,
        "name": "curruuid",
        "type": "fixed[16]",
        "required": true,
        "doc": "The event's identity: UUIDv7 ordered by millisecond and sequence, with a content payload seeded by its cross hash."
      },
      {
        "id": 10,
        "name": "crossuuid",
        "type": "fixed[16]",
        "required": true,
        "doc": "The identity every event of one chain shares, derived from the code they share; the event's own where it names none."
      },
      {
        "id": 11,
        "name": "crosscode",
        "type": "string",
        "required": false,
        "doc": "The code every event of one chain shares, as the event spells it; empty where none."
      },
      {
        "id": 12,
        "name": "currhashcode",
        "type": "long",
        "required": true,
        "doc": "The XXH3-64 of what the event states."
      },
      {
        "id": 13,
        "name": "crosshashcode",
        "type": "long",
        "required": true,
        "doc": "The XXH3-64 of the cross code; zero where the event names none."
      },
      {
        "id": 14,
        "name": "prevuuid",
        "type": "fixed[16]",
        "required": false,
        "doc": "The identity of the event this one follows, where it follows one."
      },
      {
        "id": 15,
