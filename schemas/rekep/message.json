          "python.kind": "class",
          "python.module": "datetime",
          "python.qualname": "datetime"
        }
      },
      {
        "name": "timepartition",
        "dtype": {
          "type": "datetime64",
          "unit": "microsecond",
          "timezone": "UTC"
        },
        "nullable": true,
        "metadata": {
          "description": "Timestamp partitioned by its UTC hour in Iceberg.",
          "iceberg:partition_key": "hour",
          "partition:sources": "[\"timestamp\"]",
          "python.class": "datetime",
          "python.kind": "class",
          "python.module": "datetime",
          "python.qualname": "datetime"
